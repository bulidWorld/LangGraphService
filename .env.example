# Required by langchain-openai. Use any OpenAI-compatible endpoint if desired.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# LangGraph 上下文压缩策略
CONTEXT_COMPRESSION_ENABLED=true
CONTEXT_WINDOW_TOKENS=128000
CONTEXT_KEEP_RECENT_MESSAGES=12
CONTEXT_COMPRESSION_FALLBACK_TURNS=200

# PostgreSQL connection. Keep DB_PASSWORD in a secret store in deployments.
DB_HOST=pg-ha-rw.database.svc.cluster.local
DB_PORT=5432
DB_NAME=autotestservice-db
DB_USER=autotestservice
DB_PASSWORD=

# MCP Bearer Token used by the Authorization header in mcp_server.json.
MCP_BEARER_TOKEN=
